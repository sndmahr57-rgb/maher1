{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{ffmpeg-static/ffmpeg,ffprobe-static/bin/linux/x64/ffprobe}"
    }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/fallback"
    }
  ]
}
